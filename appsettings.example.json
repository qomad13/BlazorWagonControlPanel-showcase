{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "VagonLab.Controllers.PlcCommandController": "Information",
      "VagonLab.Controllers.TestPlcAcknowledgmentController": "Information",
      "VagonLab.Plc.ModbusProtocol": "Error",
      "VagonLab.Plc.PlcBus": "Error",
      "VagonLab.Plc.PlcLogicEngine": "Information",
      "VagonLab.Services.ProcessStateService": "Information",
      "VagonLab.Services.ModeComplexLogicService": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=vagonlab.db",
    "OneCDatabase": "Server=CHANGE_ME_HOST;Port=CHANGE_ME_PORT;Database=CHANGE_ME_DB;Uid=CHANGE_ME_USER;Pwd=CHANGE_ME_PASSWORD;CharSet=utf8mb4;"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_MINIMUM_32_CHARACTERS_SECRET_KEY_FOR_JWT",
    "Issuer": "VagonLab",
    "Audience": "VagonLab",
    "ExpirationDays": 7
  },
  "AllowedHosts": "*",
  "Modbus": {
    "IpAddress": "CHANGE_ME_PLC_IP",
    "Port": 502,
    "SlaveId": 1,

    "Track1ModeRegister": 0,
    "Track1CmdScadaToPlcRegister": 1,
    "Track1CmdPlcToScadaRegister": 2,
    "Track1BridgeMaskRegister": 3,
    "Track1WagonPresentRegister": 4,

    "Track2ModeRegister": 8,
    "Track2CmdScadaToPlcRegister": 9,
    "Track2CmdPlcToScadaRegister": 10,
    "Track2BridgeMaskRegister": 11,
    "Track2WagonPresentRegister": 12,

    "EnableBridgePolling": true
  },
  "Printer": {
    "IpAddress": "CHANGE_ME_PRINTER_IP",
    "Port": 9100,
    "EncodingName": "utf-8"
  }
}

