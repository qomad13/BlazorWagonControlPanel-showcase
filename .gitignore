# Showcase repository: documentation only

# Exclude all code, keep documentation only
/*
!README.md
!DEMO_INSTRUCTIONS.md
!.gitattributes
!.gitignore
!docs/
!backend/
!frontend/
!sql/
!appsettings.example.json
!docker-compose.example.yml

# Inside backend and frontend keep only the needed files
backend/*
!backend/WHERE_TO_LOOK.md
!backend/ENV_EXAMPLE.md

frontend/*
!frontend/WHERE_TO_LOOK.md
!frontend/README.md

# Exclude temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

